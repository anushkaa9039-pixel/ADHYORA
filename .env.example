# Local: copy this file to .env and restart the server after editing it.
# Deployed (Vercel): do NOT upload .env. Add the same names under Project Settings -> Environment Variables, then REDEPLOY
# (Vercel only applies new variables to new deployments).
#
# AI is optional. Without a key, Class 10 Physics and Mathematics still work completely.
# Every other subject (English, Chemistry, ...), AI-written syllabus/tests and the Study Buddy chat need ONE of these keys.
# No quotes, no spaces.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: choose which one is used when both are set (anthropic or gemini). Default: Anthropic if its key exists.
AI_PROVIDER=
# Optional model overrides. Leave empty to use the defaults.
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-2.5-flash
PORT=3001
