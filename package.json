{
  "name": "adhyora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/local.ts\" \"vite\"",
